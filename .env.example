# LLM API Keys (нужен ОДИН из двух)
# Вариант 1: Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# Вариант 2: OpenAI (GPT-4o)
# OPENAI_API_KEY=sk-...
# + в config/kali.yaml поменять cloud_provider на "openai" и cloud_model на "gpt-4o"

# Local LLM (опционально)
# OLLAMA_HOST=http://localhost:11434

# Optional integrations
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# HOME_ASSISTANT_URL=
# HOME_ASSISTANT_TOKEN=

# Telegram Bot
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Google OAuth (download from console.cloud.google.com → data/google_credentials.json)
