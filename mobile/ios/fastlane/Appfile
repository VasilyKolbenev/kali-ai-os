# fastlane Appfile — iOS (App Store Connect).
# https://docs.fastlane.tools/advanced/#appfile
#
# Bundle id matches the iOS target (Runner/Info.plist PRODUCT_BUNDLE_IDENTIFIER
# resolves to ai.kali.mobile) and the Android package name.
#
# No Apple ID / team id is hardcoded — they are supplied at runtime via the
# App Store Connect API key (see the Fastfile) and the optional
# APPLE_TEAM_ID / ITC_TEAM_ID env vars when an account exists.

app_identifier("ai.kali.mobile")

apple_id(ENV["FASTLANE_APPLE_ID"]) if ENV["FASTLANE_APPLE_ID"]
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]
itc_team_id(ENV["ITC_TEAM_ID"]) if ENV["ITC_TEAM_ID"]
