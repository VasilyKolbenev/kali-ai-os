# Android release signing — COPY this file to `keystore.properties` (which is
# gitignored) and fill in real values. NEVER commit the real keystore or its
# passwords.
#
# Generate a throwaway local upload keystore for testing with:
#   keytool -genkey -v -keystore upload-keystore.jks -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to the android/ directory (rootProject), so an
# absolute path or a path like `upload-keystore.jks` both work.
#
# Each property can also be supplied via the matching env var (useful in CI):
#   storeFile     -> KALI_UPLOAD_STORE_FILE
#   storePassword -> KALI_UPLOAD_STORE_PASSWORD
#   keyAlias      -> KALI_UPLOAD_KEY_ALIAS
#   keyPassword   -> KALI_UPLOAD_KEY_PASSWORD

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
